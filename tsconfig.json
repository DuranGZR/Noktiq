  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "skipLibCheck": true, "jsx": "react-jsx", "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
