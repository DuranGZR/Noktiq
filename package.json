{
  "name": "noktiq",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Duran Gezer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DuranGZR/Noktiq.git"
  },
  "homepage": "https://github.com/DuranGZR/Noktiq#readme",
  "bugs": {
    "url": "https://github.com/DuranGZR/Noktiq/issues"
  },
  "description": "Point. Note. Paste. Visual feedback for React and Vue.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/**/*.md",
    "docs/assets/*.svg"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./webpack-loader": "./dist/webpack-loader.cjs",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit.test.mjs",
    "test:e2e": "playwright test --project=chrome",
    "test:cross-browser": "playwright test --project=firefox --project=webkit",
    "test:all-browsers": "playwright test",
    "report:validation": "node scripts/write-validation-report.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:integrations": "node scripts/verify-integrations.mjs",
    "dev:react": "vite examples/react --host 127.0.0.1 --port 5173 --strictPort",
    "dev:vue": "vite examples/vue --host 127.0.0.1 --port 5174 --strictPort",
    "build:examples": "vite build examples/react && vite build examples/vue",
    "prepack": "npm run build",
    "prepublishOnly": "node -e \"throw new Error('Publish the reviewed archive with npm publish ./noktiq-0.1.0.tgz, not the source directory.')\"",
    "pack:release": "npm run build && node scripts/pack-package.mjs",
    "verify:compatibility": "node scripts/verify-compatibility.mjs",
    "prepare:ecosystem": "node scripts/prepare-ecosystem.mjs",
    "test:ecosystem": "playwright test -c playwright.ecosystem.config.ts",
    "report:ecosystem": "node scripts/report-ecosystem.mjs",
    "record:readme": "node scripts/record-readme.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": ">=18",
    "vite": ">=6",
    "vue": ">=3.4"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^7.28.0",
    "@babel/traverse": "^7.29.12",
    "@jridgewell/remapping": "^2.3.5",
    "@vue/compiler-dom": "^3.5.0",
    "@vue/compiler-sfc": "^3.5.0",
    "magic-string": "^0.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "next": "^16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vue": "^3.5.0",
    "webpack": "^5.112.2"
  }
}
